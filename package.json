{
  "name": "pi-music-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Classical music composition harness: compose -> validate -> critique -> iterate -> render -> store, in ABC notation.",
  "license": "GPL-3.0-or-later",
  "author": "Finnduas (https://github.com/Finnduas)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Finnduas/pi-music-agent.git"
  },
  "homepage": "https://github.com/Finnduas/pi-music-agent#readme",
  "bugs": {
    "url": "https://github.com/Finnduas/pi-music-agent/issues"
  },
  "keywords": [
    "abc-notation",
    "music",
    "composition",
    "llm",
    "openrouter",
    "ollama",
    "n8n",
    "sheet-music",
    "abcjs"
  ],
  "bin": {
    "music-agent": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:n8n": "node scripts/gen-n8n.mjs",
    "smoke": "tsx scripts/smoke-music.ts && tsx scripts/smoke-transpose.ts && tsx scripts/smoke-transpose-oracle.ts && tsx scripts/smoke-render.ts && tsx scripts/smoke-convert.ts && tsx scripts/smoke-loop.ts && tsx scripts/smoke-edit.ts && tsx scripts/smoke-n8n.ts && tsx scripts/smoke-server.ts",
    "scenario": "node scripts/scenario-live.mjs",
    "check:n8n": "node scripts/check-n8n.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "serve": "node dist/cli.js serve"
  },
  "dependencies": {
    "abcjs": "^6.4.4",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
